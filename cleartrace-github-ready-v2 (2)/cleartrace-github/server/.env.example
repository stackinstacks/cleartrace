# ClearTrace Server Configuration
# Copy this file to .env and fill in your credentials
# Do NOT commit .env to version control

# Server Configuration
PORT=8787
FRONTEND_ORIGIN=http://localhost:8000

# Government Records & Court Data
# ===============================

# CourtListener API (Opinions & RECAP/docket records)
# Get your token at: https://www.courtlistener.com/api/rest/v3/
# Documentation: https://www.courtlistener.com/api/
COURTLISTENER_API_TOKEN=

# Authorized Public Records Provider
# Configure your public-records aggregator endpoint and authentication
# This provider searches: criminal_court, civil_court, bankruptcy, 
# professional_license, business_entity, regulatory_enforcement, 
# public_contracts, campaign_finance, property_tax, judgment_lien
PUBLIC_RECORDS_API_URL=
PUBLIC_RECORDS_API_TOKEN=

# Social Media & Web Search Providers (Optional)
# ==============================================

# X (formerly Twitter) API
# Get your credentials at: https://developer.twitter.com/
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# LinkedIn API
# Apply for access at: https://www.linkedin.com/developers/
LINKEDIN_API_KEY=
LINKEDIN_API_SECRET=

# Meta (Instagram) Graph API
# Set up at: https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# NewsAPI (Optional, for news article aggregation)
# Get your key at: https://newsapi.org/
NEWSAPI_KEY=
